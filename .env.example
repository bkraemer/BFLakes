# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# Required for Stage 1 (place resolution) and Stage 2 (review fetch).
# Enable "Places API (New)" in Google Cloud Console for this key.
GOOGLE_MAPS_API_KEY=

# Optional. If set, Stage 3 translates via DeepL. If unset, falls back to
# the Anthropic API.
DEEPL_API_KEY=

# Required for Stage 3 fallback translation (used automatically when
# DEEPL_API_KEY is not set).
ANTHROPIC_API_KEY=
